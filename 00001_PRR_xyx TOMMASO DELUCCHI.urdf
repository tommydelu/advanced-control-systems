<?xml version="1.0"?>              <!--Indica al SW/interprete che questo è un file xml versione 1.0-->

<robot name="robot_00001_PRR_xyx"> <!--Contenitore principale di tutto il documento, ogni file xml 
                                       ha un solo elemento radice, robot è lo standard per file urdf-->

  <link name="world" />            <!--Apertura e chiusura di un elemento senza proprietà-->

  <link name="base_link">

    <visual>                                 <!--Aspetto grafico del link-->
      <origin xyz="0 0 0.075" rpy="0 0 0" /> <!--Origine grafica del link-->
      <geometry>                             <!--Geometria link-->
        <box size="0.072 0.072 0.15" />
      </geometry>
      <material name="base_link_color">      <!--Colore link-->
        <color rgba="0.3 0.35 0.4 1" />
      </material>
    </visual>

    <collision>                              <!--Volume su cui sono calcolati urti e contatti, spesso uguale a geometria visuale del link-->
      <origin xyz="0 0 0.075" rpy="0 0 0" />
      <geometry>
        <box size="0.072 0.072 0.15" />
      </geometry>
    </collision>

    <inertial>                               <!--Per simulazione dinamiche e considerare massa, inerzia (distribuzione massa attorno agli assi), origine CoM-->
      <origin xyz="0 0 0.075" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0" />
    </inertial>

    <visual>                                 <!--Altro elemento visual sempre facente parte del base link-->
      <origin xyz="0 0 0.15" rpy="0 1.5707963267948966 0" />
      <geometry>
        <box size="0.04 0.04 0.06" />
      </geometry>
      <material name="link_1_joint_color">
        <color rgba="0 0 1.0 1" />
      </material>
    </visual>

  </link>
    
  <!--Origin non specificata, quindi world e base coincidono. Inoltre non c'è movimento tra i due -->
  <joint name="world_fixed" type="fixed">
    <parent link="world" />
    <child link="base_link" />
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.5707963267948966 0" />
      <geometry>
        <box size="0.036 0.036 0.5" />
      </geometry>
      <material name="link_1_color">
        <color rgba="0.2 0.55 0.95 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 1.5707963267948966 0" />
      <geometry>
        <box size="0.036 0.036 0.5" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0.5 0 0" rpy="-1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius="0.026000000000000002" length="0.04" />
      </geometry>
      <material name="link_2_joint_color">
        <color rgba="1.0 0 0 1" />
      </material>
    </visual>
  </link>

  <joint name="joint_1" type="prismatic">
    <parent link="base_link" />
    <child link="link_1" />
    <origin xyz="0 0 0.15" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.5" upper="0" effort="100" velocity="1" />
    <dynamics damping="0" friction="0" />
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.019" length="0.4" />
      </geometry>
      <material name="link_2_color">
        <color rgba="0.9 0.35 0.22 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.019" length="0.4" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.4" rpy="0 1.5707963267948966 0" />
      <geometry>
        <cylinder radius="0.026000000000000002" length="0.04" />
      </geometry>
      <material name="link_3_joint_color">
        <color rgba="1.0 0 0 1" />
      </material>
    </visual>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1" />
    <child link="link_2" />
    <origin xyz="0.5 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159265359" upper="3.14159265359" effort="100" velocity="1" />
    <dynamics damping="0" friction="0" />
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.019" length="0.4" />
      </geometry>
      <material name="link_3_color">
        <color rgba="0.9 0.35 0.22 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.019" length="0.4" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2" />
    <child link="link_3" />
    <origin xyz="0 0 0.4" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14159265359" upper="3.14159265359" effort="100" velocity="1" />
    <dynamics damping="0" friction="0" />
  </joint>

  <link name="ee" />
  
    <!--Quindi il frame EE è spostato di 0.4 rispetto al frame3 ed è ruotato allo stesso modo-->
  <joint name="ee_joint" type="fixed">
    <parent link="link_3" />
    <child link="ee" />
    <origin xyz="0 0 0.4" rpy="0 0 0" />
  </joint>

</robot>
